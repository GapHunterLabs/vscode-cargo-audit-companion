{
  "name": "cargo-audit-companion",
  "displayName": "Cargo Audit Companion",
  "description": "Wraps 'cargo audit --json' as inline VS Code diagnostics on Cargo.toml -- RustSec advisory database check for your dependencies.",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "rust",    "cargo",    "security",    "audit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-cargo-audit-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-cargo-audit-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cargoAuditCompanion.run",
        "title": "Cargo Audit Companion: Run Audit"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
